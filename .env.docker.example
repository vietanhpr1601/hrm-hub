# Mẫu cấu hình cho docker compose. Cách dùng:
#   copy .env.docker.example .env      (Windows)
#   cp .env.docker.example .env        (Linux/VPS)
# rồi thay các giá trị "doi-..." bên dưới. Không đưa file .env lên Git.

# Cổng web mở ra ngoài (VPS dùng 80; máy cá nhân nếu cổng 80 bận thì đổi, ví dụ 8088)
HTTP_PORT=80

# CSDL PostgreSQL trong container
DB_USER=hrm
DB_PASSWORD=doi-mat-khau-csdl

# Khoá ký JWT: chuỗi ngẫu nhiên, ít nhất 32 ký tự
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-it-nhat-32-ky-tu

# Tài khoản Admin tạo lần đầu khi CSDL còn trống
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-admin
ADMIN_EMAIL=admin@hrm.com

# Email phiếu lương qua Gmail (cần App Password của Google). Chưa dùng thì để false.
PAYROLL_MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=

# Chatbot AI (không bắt buộc)
GROQ_API_KEY=

# Vị trí văn phòng cho chấm công (không bắt buộc)
ATTENDANCE_WORKPLACE_NAME=
ATTENDANCE_WORKPLACE_LATITUDE=
ATTENDANCE_WORKPLACE_LONGITUDE=
